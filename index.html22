<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>QUP Protocol - تجربة النقل النفاث</title>
<style>
/* تصميمك الأصلي مع تحسينات بسيطة للكانفاس */
html,body{margin:0;height:100%;font-family:sans-serif;background:#0a0a0a;color:#eee;overflow: hidden;}
#chat{display:flex;flex-direction:column;height:100%}
#msgs{flex:1;overflow:auto;padding:10px;display: flex; flex-direction: column; align-items: center;}

/* منطقة العرض (الكانفاس) */
#matrixCanvas {
    max-width: 95%;
    max-height: 70vh;
    border: 2px solid #00d4ff;
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
    background: #000;
    margin-top: 10px;
}

#bar{display:flex;padding:15px;gap:10px;border-top:1px solid #222;background: #111;}
input[type=text]{flex:1;padding:10px;border-radius:8px;border:none;background: #222;color: white;}
button{padding:10px 20px;border:none;border-radius:8px;background:#00d4ff;color:#000;cursor:pointer;font-weight: bold;}
button:disabled {background: #444; cursor: not-allowed;}
input[type=file]{display:none}

/* شريط النسبة المئوية الذي أضفناه في Zied.js سيظهر هنا بتنسيق جميل */
#progressStatus {
    width: 100%;
    text-align: center;
    font-family: monospace;
    padding: 5px;
    background: #111;
    border-bottom: 1px solid #222;
}
</style>
</head>
<body>

<div id="chat">
  <div id="progressStatus">جاهز للإرسال...</div>

  <div id="msgs">
    <canvas id="matrixCanvas"></canvas>
  </div>

  <div id="bar">
    <button onclick="document.getElementById('fileInput').click()">📎 اختيار صورة</button>
    <input id="fileInput" type="file" accept="image/*" />
    <button id="sendBtn" disabled>🚀 إرسال بالنظام النفاث</button>
  </div>
</div>

<script type="module" src="Zied.js"></script>

</body>
</html>
